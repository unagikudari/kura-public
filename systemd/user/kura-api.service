[Unit]
Description=kura API (FastAPI + asyncpg)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
# Runaway backstop — baseline RSS is ~3.4G (uvicorn --workers 4 over a
# 384k-post DB). MemoryHigh throttles via reclaim pressure first; MemoryMax
# hard-kills only on a true leak, well clear of normal operation. Node has
# ~16G total, so this can't OOM the whole WSL2 host.
MemoryHigh=6G
MemoryMax=8G
KillMode=control-group
TimeoutStopSec=10
ExecStopPost=-/usr/bin/fuser -k 8001/tcp
WorkingDirectory=%h/kura
EnvironmentFile=%h/kura/api/env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/share/kura-api/venv/bin/uvicorn \
    api.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 4 \
    --timeout-worker-healthcheck 30 \
    --no-server-header
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kura-api

[Install]
WantedBy=default.target
