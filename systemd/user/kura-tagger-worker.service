[Unit]
Description=kura auto-tagger worker (WD14; README "Auto-tagging")
After=network-online.target kura-api.service
Wants=network-online.target

[Service]
Type=simple
# Without an active tagger release the worker refuses to start; it retries instead of giving up.
Restart=always
RestartSec=30
WorkingDirectory=%h/kura
EnvironmentFile=%h/kura/tagger/env
Environment=PYTHONUNBUFFERED=1
Environment=TAGGER_PROFILE=wd14
Environment=KURA_MODELS_DIR=%h/.cache/kura-tagger/models
ExecStart=%h/.local/share/kura-tagger/venv/bin/python -m tagger.worker
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kura-tagger-worker
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=default.target
