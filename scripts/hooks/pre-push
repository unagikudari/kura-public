#!/usr/bin/env bash
# kura pre-push — torch を要する検査を、push の前に **必ず** 走らせる。
#
# ■ なぜ (2026-09-04)
#
# `train_heads.py` の損失を per-sample 重みへ変えたとき、「既存タグの学習は変わらない」を
# torch で実測して確かめた。しかし kura の test venv に torch は無く、その 2 本は
# `importorskip` で skip されていた — **実測は済んでいるのに回帰は守れていない**状態。
#
# 敵対的レビュー (primary-codex) の blocking:
#   > A one-off measurement does not protect future changes.
#   > Add a required torch-capable CI/job and make its result a merge/release gate.
#
# 「必須」を成立させるのは gate であって、走らせられることではない。scripts/
# run_torch_tests.sh は「走らせられる」だけだったので、ここで push に紐付ける。
#
# ■ 触る変更のときだけ走らせる
#
# torch 検査は 3 秒弱だが、無関係な push まで巻き込むと **無視される gate** になる。
# 学習の意味に触るファイルが push に含まれるときだけ走らせ、それ以外は素通しする。
#
# bypass: git push --no-verify (明示的な意思表示のみ)
set -uo pipefail

repo=$(git rev-parse --show-toplevel)
WATCH='^tagger/heads/(train_heads|planner)\.py$|^tests/test_heads_planner\.py$'

# push される commit の範囲を stdin から読む (pre-push の契約)。
# 読めない/空なら **走らせる** — 判断できないときに素通しするのは gate ではない。
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        range="$local_sha"          # 新しい branch: その commit だけ見る
        changed+=$(git show --name-only --pretty=format: "$range" 2>/dev/null)
    else
        changed+=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)
    fi
    changed+=$'\n'
done

if [ -n "$changed" ] && ! echo "$changed" | grep -qE "$WATCH"; then
    exit 0
fi

echo "[pre-push] 学習の意味に触る変更を検出 — torch ゲートを走らせます"
if ! bash "$repo/scripts/run_torch_tests.sh"; then
    echo "" >&2
    echo "[pre-push] BLOCK: torch ゲートが失敗しました。" >&2
    echo "  損失や負例構成の意味を変える変更が、無検査で push されるのを止めています。" >&2
    echo "  意図的な例外は git push --no-verify (明示的な意思表示のみ)。" >&2
    exit 1
fi
exit 0
