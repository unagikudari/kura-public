# Database (matches szurubooru .env)
POSTGRES_DB=szurubooru
POSTGRES_USER=szurubooru
POSTGRES_PASSWORD=szurubooru

# kura config
# Frozen naming input, NOT a credential: it builds every content filename
# ({post_id}_{16hex}.{ext}). On an existing deployment this must be the value the
# files were named with — changing it renames two million files (kura#43-2).
# JOINING AN EXISTING CLUSTER: copy the value from a node that already serves
# media. Do NOT generate one. A GENUINELY NEW CLUSTER with no media: any stable
# value, chosen once. Left empty on purpose — kura-api refuses to start unset,
# and a non-empty placeholder here would just start and 404 everything.
KURA_FS_NAME_SALT=
# Retiring: was the filename salt AND the session signing key at once, which made
# the credential un-rotatable (kura#59). New deployments do not need it.
KURA_SECRET=change-me-to-match-szurubooru-secret
DATA_PATH=./data
API_PORT=8000

# kura base URL for scripts/workers: the API on this machine, or the address
# your reverse proxy serves it at when they run elsewhere.
KURA_URL=http://127.0.0.1:8001
KURA_LOCAL_URL=http://127.0.0.1:8001

# External services
OLLAMA_URL=http://host.docker.internal:11434
