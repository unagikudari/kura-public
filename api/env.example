# kura-api environment (copy to api/env and fill in secrets)
DATABASE_URL=postgresql+asyncpg://kura:kura@localhost:5432/kura
DATA_DIR=./data-images
DATA_URL=/data
# Optional external original archive. Run offload only after mount and policy checks.
KURA_ORIGINAL_ARCHIVE_ROOT=
# The salt in every content filename ({post_id}_{16hex}.{ext}). FROZEN, and NOT
# a credential despite where it used to live: /api/post/{id}/content answers
# without auth on the same reach, so the unguessable name protects nothing (#58).
#
# JOINING AN EXISTING CLUSTER (this is almost certainly you): copy the value from
# a node that already serves media. Do NOT generate one — two million files are
# already named by the existing value, and a fresh one 404s all of them. kura-api
# now samples real filenames at boot and refuses to start if the salt does not
# derive them, so a wrong value fails immediately instead of at read time.
#
# A GENUINELY NEW INSTALL with no media yet: ops/install/make_env.py generates it
# (43 characters). Chosen once and never changed; kura-api refuses one shorter than
# 32 characters while no file is named with it (kura#61).
KURA_FS_NAME_SALT=
# Retiring (kura#43-2 / #59): this was the filename salt AND the web session
# signing key at once, which is why it was never rotated. The session moved to
# KURA_SESSION_SECRET in web/.env.server; the salt moved to the line above.
KURA_SECRET=change-me
OLLAMA_URL=http://localhost:11434
# Pipeline auth: the upload/import workers (uploader_worker, integrity_scan, …)
# POST/DELETE to the now token-gated /api/upload, /api/posts, /api/post/{id}.
# Without a VALID token these requests get 401 (they used to pass as anonymous
# when those endpoints were get_optional_user). KURA_TOKEN must be a real
# user_token for KURA_USER. (The web SSR proxy uses its own web/.env.server.)
KURA_USER=admin
KURA_TOKEN=change-me
# Workers must target the canonical writer, including when installed on a replica.
# Set explicitly for your deployment; no host-specific fallback is used.
KURA_URL=https://archive.example.invalid
# Job completion notifications (used by extension workers). No hardcoded
# fallback lives in the repo anymore — provide the bot token + chat id here
# (worker units source this file). Unset → notification is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional public hint in a replica write-refusal response.
KURA_CANONICAL_URL=https://archive.example.invalid
