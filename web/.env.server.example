# Copy to .env.server and set the origin for your deployment.
INTERNAL_API_URL=http://127.0.0.1:8001
ORIGIN=https://archive.example.invalid
# Generate a private KURA_SESSION_SECRET before starting the web server.
# Optional navigation. Omit KURA_NAV_LINKS to show no external links.
# KURA_NAV_LINKS='[{"label":"Help","url":"https://help.example.invalid/"}]'
# Where the menu's source link points (AGPL-3.0). Set it when you run a modified kura.
# KURA_SOURCE_URL=https://github.com/unagikudari/kura-public
# The language for people who have not picked one in the menu (en or ja). Unset: their
# browser's language, else English.
# KURA_UI_LOCALE=ja
