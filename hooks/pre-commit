#!/bin/sh
# kura tracked hook entrypoint — pre-commit.
#
# git は core.hooksPath=hooks で **このファイル** を実行する。実装は置かず、いま
# checkout されている worktree の scripts/hooks/pre-commit へ渡すだけにする。
#
# ■ なぜ実装を直に置かないか (kura#120)
#
# 以前ここは 1 つの checkout の `scripts/hooks/pre-commit` を指す **絶対 symlink** だった。
# 別ホストの clone や linked worktree ではその絶対パスが存在しない/別の checkout を
# 指すので、symlink は宙ぶらりんになる。そして **git は存在しない hook を黙って無視
# する** — 警告も出ないまま、documented なゲートが外れる。
#
# 実装への参照を worktree ごとに解決すれば、どの clone でも「そこにある実装」が走る。
#
# bypass: git commit --no-verify (明示的な意思表示のみ)
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
if [ -z "$root" ]; then
    echo "[hooks] BLOCK: worktree の root を解決できません (git rev-parse --show-toplevel)。" >&2
    echo "  ゲートを走らせられないので commit を止めます。" >&2
    exit 1
fi

impl="$root/scripts/hooks/pre-commit"
if [ ! -x "$impl" ]; then
    echo "[hooks] BLOCK: 実装が実行可能な形で見つかりません: $impl" >&2
    echo "  この branch に scripts/hooks/pre-commit があるか、実行ビットが立っているか確認してください" >&2
    echo "  (chmod +x scripts/hooks/pre-commit)。検査不能を「合格」にはしません。" >&2
    exit 1
fi

exec "$impl" "$@"
